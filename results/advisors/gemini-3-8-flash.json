        },
        {
          "table": "web_returns",
          "columns": ["wr_returned_date_sk"],
          "include": []
        },
        {
          "table": "customer",
          "columns": ["c_current_addr_sk"],
          "include": []
        },
        {
          "table": "catalog_sales",
          "columns": ["cs_order_number"],
          "include": []
        },
        {
