{
  "model": "gemini-3-8-flash",
  "configs": [
    {
      "name": "returns_and_address_fks",
      "rationale": "Adds missing return date indexes on the three returns tables and foreign key index on customer address to eliminate repetitive sequential scans across multiple queries with negligible build overhead.",
      "indexes": [
        {
          "table": "store_returns",
          "columns": ["sr_returned_date_sk"],
          "include": []
        },
        {
          "table": "catalog_returns",
          "columns": ["cr_returned_date_sk"],
          "include": []
        },
        {
          "table": "web_returns",
          "columns": ["wr_returned_date_sk"],
          "include": []
        },
        {
          "table": "customer",
          "columns": ["c_current_addr_sk"],
          "include": []
        }
      ]
    },
    {
      "name": "store_sales_scan_reduction",
      "rationale": "Targets store_sales to replace repetitive full table scans in queries 09, 44, and 88 with index-only and targeted index scans on quantity, store, and composite sold date.",
      "indexes": [
        {
          "table": "store_sales",
          "columns": ["ss_quantity"],
          "include": ["ss_ext_discount_amt", "ss_net_paid"]
        },
        {
          "table": "store_sales",
          "columns": ["ss_store_sk"],
          "include": []
        },
        {
          "table": "store_sales",
          "columns": ["ss_sold_date_sk", "ss_item_sk"],
          "include": []
        },
        {
          "table": "store_returns",
          "columns": ["sr_returned_date_sk"],
          "include": []
        },
        {
          "table": "customer",
          "columns": ["c_current_addr_sk"],
          "include": []
        }
      ]
    },
    {
      "name": "remote_order_and_shipping",
      "rationale": "Indexes order numbers and shipping dates across catalog and web channels to optimize anti-joins, existence subqueries, and delivery interval calculations.",
      "indexes": [
        {
          "table": "catalog_sales",
          "columns": ["cs_order_number", "cs_warehouse_sk"],
          "include": []
        },
        {
          "table": "catalog_returns",
          "columns": ["cr_order_number"],
          "include": []
        },
        {
          "table": "web_sales",
          "columns": ["ws_order_number", "ws_warehouse_sk"],
          "include": []
        },
        {
          "table": "web_returns",
          "columns": ["wr_order_number"],
          "include": []
        },
        {
          "table": "catalog_sales",
          "columns": ["cs_ship_date_sk"],
          "include": []
        },
        {
          "table": "web_sales",
          "columns": ["ws_ship_date_sk"],
          "include": []
        }
      ]
    },
    {
      "name": "composite_joins_and_dimensions",
      "rationale": "Uses composite date-item indexes across sales channels along with indexing customer demographics and inventory to accelerate complex multi-table joins.",
      "indexes": [
        {
          "table": "store_sales",
          "columns": ["ss_sold_date_sk", "ss_item_sk"],
          "include": []
        },
        {
          "table": "catalog_sales",
          "columns": ["cs_sold_date_sk", "cs_item_sk"],
          "include": []
        },
        {
          "table": "web_sales",
          "columns": ["ws_sold_date_sk", "ws_item_sk"],
          "include": []
        },
        {
          "table": "customer_demographics",
          "columns": ["cd_marital_status", "cd_education_status", "cd_gender"],
          "include": []
        },
        {
          "table": "store_sales",
          "columns": ["ss_store_sk"],
          "include": []
        },
        {
          "table": "inventory",
          "columns": ["inv_item_sk", "inv_date_sk"],
          "include": []
        }
      ]
    },
    {
      "name": "balanced_workload_suite",
      "rationale": "Provides a comprehensive balanced set of eight high-impact indexes addressing the primary bottleneck queries across store, catalog, and web sales and returns.",
      "indexes": [
        {
          "table": "store_sales",
          "columns": ["ss_quantity"],
          "include": ["ss_ext_discount_amt", "ss_net_paid"]
        },
        {
          "table": "store_sales",
          "columns": ["ss_store_sk"],
          "include": []
