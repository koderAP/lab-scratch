{
  "model": "gpt-5.6-sol",
  "configs": [
    {
      "name": "order correlation",
      "rationale": "Accelerate the repeated same-order self joins and return anti-joins in the catalog and web shipping queries.",
      "indexes": [
        {
          "table": "catalog_sales",
          "columns": ["cs_order_number", "cs_warehouse_sk"],
          "include": []
        },
        {
          "table": "catalog_returns",
          "columns": ["cr_order_number"],
          "include": []
        },
        {
          "table": "catalog_sales",
          "columns": ["cs_ship_date_sk", "cs_ship_addr_sk", "cs_call_center_sk", "cs_order_number"],
          "include": ["cs_warehouse_sk", "cs_ext_ship_cost", "cs_net_profit"]
        },
        {
          "table": "web_sales",
          "columns": ["ws_order_number", "ws_warehouse_sk"],
          "include": []
        },
        {
          "table": "web_returns",
          "columns": ["wr_order_number"],
          "include": []
        },
        {
          "table": "web_sales",
          "columns": ["ws_ship_date_sk", "ws_ship_addr_sk", "ws_web_site_sk", "ws_order_number"],
          "include": ["ws_warehouse_sk", "ws_ext_ship_cost", "ws_net_profit"]
        }
      ]
    },
    {
      "name": "customer windows",
      "rationale": "Target customer existence checks and date-bounded return aggregation while keeping all join keys adjacent.",
      "indexes": [
        {
          "table": "store_sales",
          "columns": ["ss_customer_sk", "ss_sold_date_sk"],
          "include": []
        },
        {
          "table": "web_sales",
          "columns": ["ws_bill_customer_sk", "ws_sold_date_sk"],
          "include": []
        },
        {
          "table": "catalog_sales",
          "columns": ["cs_ship_customer_sk", "cs_sold_date_sk"],
          "include": []
        },
        {
          "table": "customer_address",
          "columns": ["ca_state", "ca_address_sk"],
          "include": []
        },
        {
          "table": "customer",
          "columns": ["c_current_addr_sk", "c_customer_sk", "c_current_cdemo_sk"],
          "include": []
        },
        {
          "table": "store_returns",
          "columns": ["sr_returned_date_sk", "sr_customer_sk", "sr_store_sk"],
          "include": ["sr_return_amt"]
        },
        {
          "table": "catalog_returns",
          "columns": ["cr_returned_date_sk", "cr_returning_customer_sk", "cr_returning_addr_sk"],
          "include": ["cr_return_amt_inc_tax"]
        },
        {
          "table": "web_returns",
          "columns": ["wr_returned_date_sk", "wr_returning_customer_sk", "wr_returning_addr_sk"],
          "include": ["wr_return_amt"]
        }
      ]
    },
    {
      "name": "time of day",
      "rationale": "Reduce the repeated fact-table scans driven by narrow hour, minute, household, and channel-location predicates.",
      "indexes": [
        {
          "table": "store_sales",
          "columns": ["ss_sold_time_sk", "ss_store_sk", "ss_hdemo_sk"],
          "include": []
        },
        {
          "table": "web_sales",
          "columns": ["ws_sold_time_sk", "ws_web_page_sk", "ws_ship_hdemo_sk"],
          "include": []
        },
        {
          "table": "time_dim",
          "columns": ["t_hour", "t_minute", "t_time_sk"],
          "include": []
        },
        {
          "table": "household_demographics",
          "columns": ["hd_dep_count", "hd_vehicle_count", "hd_demo_sk"],
          "include": []
        }
      ]
    },
    {
      "name": "inventory probes",
      "rationale": "Make item-led inventory probes and selective price or manufacturer ranges efficient without duplicating the date-led inventory key.",
      "indexes": [
        {
          "table": "inventory",
          "columns": ["inv_item_sk", "inv_date_sk"],
          "include": ["inv_warehouse_sk", "inv_quantity_on_hand"]
        },
        {
          "table": "item",
          "columns": ["i_manufact_id", "i_current_price", "i_item_sk"],
          "include": []
        },
        {
          "table": "item",
          "columns": ["i_current_price", "i_item_sk"],
          "include": []
        },
        {
          "table": "date_dim",
          "columns": ["d_date", "d_date_sk"],
          "include": []
        }
      ]
    },
    {
      "name": "aggressive bottlenecks",
      "rationale": "Combine the highest-impact order-correlation, time-of-day, and item-led inventory indexes for the most scan-heavy workload bottlenecks.",
      "indexes": [
        {
          "table": "catalog_sales",
          "columns": ["cs_order_number", "cs_warehouse_sk"],
          "include": []
        },
        {
          "table": "catalog_returns",
          "columns": ["cr_order_number"],
          "include": []
        },
        {
          "table": "catalog_sales",
          "columns": ["cs_ship_date_sk", "cs_ship_addr_sk", "cs_call_center_sk", "cs_order_number"],
          "include": ["cs_warehouse_sk", "cs_ext_ship_cost", "cs_net_profit"]
        },
        {
          "table": "web_sales",
          "columns": ["ws_order_number", "ws_warehouse_sk"],
          "include": []
        },
        {
          "table": "web_returns",
          "columns": ["wr_order_number"],
          "include": []
        },
        {
          "table": "web_sales",
          "columns": ["ws_ship_date_sk", "ws_ship_addr_sk", "ws_web_site_sk", "ws_order_number"],
          "include": ["ws_warehouse_sk", "ws_ext_ship_cost", "ws_net_profit"]
        },
        {
          "table": "store_sales",
          "columns": ["ss_sold_time_sk", "ss_store_sk", "ss_hdemo_sk"],
          "include": []
        },
        {
          "table": "inventory",
          "columns": ["inv_item_sk", "inv_date_sk"],
          "include": ["inv_warehouse_sk", "inv_quantity_on_hand"]
        }
      ]
    }
  ]
}
