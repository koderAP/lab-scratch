{
  "model": "grok-4-7",
  "configs": [
    {
      "name": "small-dimension-filters",
      "rationale": "Cheap indexes only on dimension tables so year, month, date, item, address, customer-name, and hour predicates are index lookups while index build stays small.",
      "indexes": [
        {"table": "date_dim", "columns": ["d_year", "d_moy", "d_date_sk"], "include": []},
        {"table": "date_dim", "columns": ["d_date", "d_date_sk"], "include": []},
        {"table": "date_dim", "columns": ["d_month_seq", "d_date_sk"], "include": []},
        {"table": "item", "columns": ["i_item_id"], "include": []},
        {"table": "item", "columns": ["i_category", "i_class", "i_brand", "i_item_sk"], "include": []},
        {"table": "customer_address", "columns": ["ca_state", "ca_zip", "ca_address_sk"], "include": []},
        {"table": "customer", "columns": ["c_last_name", "c_first_name", "c_customer_sk"], "include": []},
        {"table": "time_dim", "columns": ["t_hour", "t_minute", "t_time_sk"], "include": []}
      ]
    },
    {
      "name": "store-channel-fks",
      "rationale": "Indexes the store_sales foreign keys that are not already covered so store, household, address, demographics, promotion, time, and item-plus-date joins can probe the largest sales fact, with a date index on store_returns.",
      "indexes": [
        {"table": "store_sales", "columns": ["ss_store_sk", "ss_sold_date_sk"], "include": []},
        {"table": "store_sales", "columns": ["ss_hdemo_sk"], "include": []},
        {"table": "store_sales", "columns": ["ss_addr_sk"], "include": []},
        {"table": "store_sales", "columns": ["ss_cdemo_sk"], "include": []},
        {"table": "store_sales", "columns": ["ss_promo_sk"], "include": []},
        {"table": "store_sales", "columns": ["ss_item_sk", "ss_sold_date_sk"], "include": []},
        {"table": "store_sales", "columns": ["ss_sold_time_sk"], "include": []},
        {"table": "store_returns", "columns": ["sr_returned_date_sk", "sr_store_sk", "sr_customer_sk"], "include": []}
      ]
    },
    {
      "name": "inventory-and-returns",
      "rationale": "Aims at inventory, whose primary key leads with date rather than item, and at the three returns tables, which have no date or customer indexes.",
      "indexes": [
        {"table": "inventory", "columns": ["inv_item_sk", "inv_date_sk"], "include": ["inv_quantity_on_hand", "inv_warehouse_sk"]},
        {"table": "store_returns", "columns": ["sr_returned_date_sk", "sr_item_sk"], "include": []},
        {"table": "store_returns", "columns": ["sr_customer_sk", "sr_ticket_number"], "include": []},
        {"table": "catalog_returns", "columns": ["cr_returned_date_sk", "cr_item_sk"], "include": []},
        {"table": "catalog_returns", "columns": ["cr_refunded_customer_sk"], "include": []},
        {"table": "web_returns", "columns": ["wr_returned_date_sk", "wr_item_sk"], "include": []},
        {"table": "web_returns", "columns": ["wr_refunded_customer_sk"], "include": []},
        {"table": "catalog_sales", "columns": ["cs_order_number"], "include": []}
      ]
    },
    {
      "name": "cross-channel-date-item",
      "rationale": "Puts date-then-item and item-then-date composites on all three sales facts so the dominant date_dim and item joins can use a matching column order on every channel.",
      "indexes": [
        {"table": "store_sales", "columns": ["ss_sold_date_sk", "ss_item_sk", "ss_store_sk"], "include": ["ss_quantity", "ss_ext_sales_price"]},
        {"table": "store_sales", "columns": ["ss_item_sk", "ss_sold_date_sk", "ss_store_sk"], "include": []},
        {"table": "catalog_sales", "columns": ["cs_sold_date_sk", "cs_item_sk"], "include": ["cs_quantity", "cs_ext_sales_price"]},
        {"table": "catalog_sales", "columns": ["cs_item_sk", "cs_sold_date_sk"], "include": []},
        {"table": "web_sales", "columns": ["ws_sold_date_sk", "ws_item_sk"], "include": ["ws_quantity", "ws_ext_sales_price"]},
        {"table": "web_sales", "columns": ["ws_item_sk", "ws_sold_date_sk"], "include": []},
        {"table": "date_dim", "columns": ["d_year", "d_qoy", "d_moy", "d_date_sk"], "include": []},
        {"table": "item", "columns": ["i_manufact_id", "i_category_id", "i_item_sk"], "include": []}
      ]
    },
    {
      "name": "customer-ship-paths",
      "rationale": "Follows customer, ship-date, address, and demographics paths on catalog and web sales, which the existing bill-customer and sold-date indexes do not cover.",
      "indexes": [
        {"table": "catalog_sales", "columns": ["cs_ship_customer_sk", "cs_sold_date_sk"], "include": []},
        {"table": "catalog_sales", "columns": ["cs_ship_date_sk", "cs_item_sk"], "include": []},
        {"table": "catalog_sales", "columns": ["cs_bill_cdemo_sk"], "include": []},
        {"table": "catalog_sales", "columns": ["cs_bill_addr_sk"], "include": []},
        {"table": "web_sales", "columns": ["ws_ship_customer_sk", "ws_sold_date_sk"], "include": []},
        {"table": "web_sales", "columns": ["ws_ship_date_sk", "ws_item_sk"], "include": []},
        {"table": "web_sales", "columns": ["ws_bill_addr_sk"], "include": []},
        {"table": "customer", "columns": ["c_current_addr_sk"], "include": []}
      ]
    }
  ]
}
