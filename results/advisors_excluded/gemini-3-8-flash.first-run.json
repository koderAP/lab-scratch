{
  "model": "gemini-3.8-flash",
  "configs": [
    {
      "name": "dimension-slicing",
      "rationale": "Accelerates pervasive calendar and item filtering across the workload with near-zero index build overhead on small dimension tables.",
      "indexes": [
        {
          "table": "date_dim",
          "columns": ["d_year", "d_moy", "d_date_sk"],
          "include": []
        },
        {
          "table": "date_dim",
          "columns": ["d_date", "d_date_sk"],
          "include": []
        },
        {
          "table": "date_dim",
          "columns": ["d_month_seq", "d_date_sk"],
          "include": []
        },
        {
          "table": "item",
          "columns": ["i_category", "i_current_price"],
          "include": []
        },
        {
          "table": "time_dim",
          "columns": ["t_hour", "t_minute", "t_time_sk"],
          "include": []
        },
        {
          "table": "customer_address",
          "columns": ["ca_state", "ca_address_sk"],
          "include": []
        }
      ]
    },
    {
      "name": "order-returns-reconciliation",
      "rationale": "Eliminates full table scans on cross-table transaction tracking and return reconciliations by indexing order and ticket numbers hidden behind item keys in existing primary keys.",
      "indexes": [
        {
          "table": "catalog_sales",
          "columns": ["cs_order_number", "cs_warehouse_sk"],
          "include": []
        },
        {
          "table": "catalog_returns",
          "columns": ["cr_order_number"],
          "include": []
        },
        {
          "table": "web_sales",
          "columns": ["ws_order_number", "ws_warehouse_sk"],
          "include": []
        },
        {
          "table": "web_returns",
          "columns": ["wr_order_number"],
          "include": []
        },
        {
          "table": "store_returns",
          "columns": ["sr_ticket_number"],
          "include": []
        },
        {
          "table": "store_returns",
          "columns": ["sr_returned_date_sk", "sr_customer_sk"],
          "include": []
        }
      ]
    },
    {
      "name": "store-channel-focus",
      "rationale": "Targets the dominant store sales and returns workload with composite join paths on stores, customer demographics, transaction times, and customer keys to reduce nested loop and scan costs on the largest sales volume.",
      "indexes": [
        {
          "table": "store_sales",
          "columns": ["ss_sold_date_sk", "ss_item_sk"],
          "include": []
        },
        {
          "table": "store_sales",
          "columns": ["ss_store_sk", "ss_addr_sk"],
          "include": []
        },
        {
          "table": "store_sales",
          "columns": ["ss_sold_time_sk"],
          "include": []
        },
        {
          "table": "store_sales",
          "columns": ["ss_cdemo_sk", "ss_sold_date_sk"],
          "include": []
        },
        {
          "table": "store_returns",
          "columns": ["sr_returned_date_sk", "sr_store_sk"],
          "include": []
        },
        {
          "table": "store_sales",
          "columns": ["ss_customer_sk", "ss_sold_date_sk"],
          "include": []
        }
      ]
    },
    {
      "name": "multichannel-fulfillment-inventory",
      "rationale": "Optimizes multi-channel fulfillment and inventory analytics by providing item-first access on inventory, ship-date paths for catalog and web orders, and cross-channel date-item composites.",
      "indexes": [
        {
          "table": "inventory",
          "columns": ["inv_item_sk", "inv_date_sk"],
          "include": []
        },
        {
          "table": "catalog_sales",
          "columns": ["cs_sold_date_sk", "cs_item_sk"],
          "include": []
        },
        {
          "table": "web_sales",
          "columns": ["ws_sold_date_sk", "ws_item_sk"],
          "include": []
        },
        {
          "table": "catalog_sales",
          "columns": ["cs_ship_date_sk", "cs_warehouse_sk"],
          "include": []
        },
        {
          "table": "web_sales",
          "columns": ["ws_ship_date_sk", "ws_ship_addr_sk"],
          "include": []
        },
        {
          "table": "customer",
          "columns": ["c_current_addr_sk", "c_customer_sk"],
          "include": []
        },
        {
          "table": "catalog_sales",
          "columns": ["cs_ship_addr_sk"],
          "include": []
        }
      ]
    },
    {
      "name": "critical-bottlenecks-covering",
      "rationale": "An aggressive configuration targeting the benchmark's costliest long-running query bottlenecks, pairing order correlation and correlated subquery index paths with covering columns on high-volume fact aggregations.",
      "indexes": [
        {
          "table": "item",
          "columns": ["i_category", "i_current_price"],
          "include": []
        },
        {
          "table": "catalog_sales",
          "columns": ["cs_order_number", "cs_warehouse_sk"],
          "include": []
        },
        {
          "table": "web_sales",
          "columns": ["ws_order_number", "ws_warehouse_sk"],
          "include": []
        },
        {
          "table": "web_returns",
          "columns": ["wr_order_number"],
          "include": []
        },
        {
          "table": "store_returns",
          "columns": ["sr_ticket_number"],
          "include": []
        },
        {
          "table": "inventory",
          "columns": ["inv_item_sk", "inv_date_sk"],
          "include": ["inv_quantity_on_hand"]
        },
        {
          "table": "store_sales",
          "columns": ["ss_sold_date_sk", "ss_item_sk"],
          "include": ["ss_quantity", "ss_ext_sales_price", "ss_net_profit"]
        },
        {
          "table": "date_dim",
          "columns": ["d_year", "d_moy", "d_date_sk"],
          "include": []
        }
      ]
    }
  ]
}
